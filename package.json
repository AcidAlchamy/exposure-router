    "test": "node --import tsx --test test/costSurface.test.ts test/metrics.test.ts",
    "bench": "node --import tsx bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
